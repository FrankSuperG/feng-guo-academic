{% assign metrics = site.data.publication_metrics %}
{% if metrics.by_year.size > 0 %}
  <section class="home-section home-output" aria-labelledby="home-output-title" data-publication-chart>
    <div class="home-section-heading">
      <div>
        <p class="home-kicker">Research Output</p>
        <h2 id="home-output-title">A growing body of research.</h2>
      </div>
      <div class="publication-chart-modes" role="group" aria-label="Publication chart mode">
        <button type="button" data-chart-mode="count" aria-pressed="true">By year</button>
        <button type="button" data-chart-mode="cumulative" aria-pressed="false">Cumulative</button>
      </div>
    </div>
    <figure class="publication-chart" aria-labelledby="publication-chart-caption">
      <div class="publication-chart__summary">
        <span
          ><strong>{{ metrics.published_accepted }}</strong> published & accepted papers</span
        >
        <span class="publication-chart__legend"><span></span> <span data-chart-legend aria-live="polite">Papers by publication year</span></span>
      </div>
      <ol class="publication-chart__bars" style="--chart-columns: {{ metrics.by_year.size }}" aria-label="Published and accepted papers by year">
        {% for row in metrics.by_year %}
          {% assign bar_height = row.count | times: 100.0 | divided_by: metrics.maximum_year_count %}
          <li
            data-year="{{ row.year }}"
            data-count="{{ row.count }}"
            data-cumulative="{{ row.cumulative }}"
            aria-label="{{ row.year }}: {{ row.count }} papers"
            tabindex="0"
            title="{{ row.year }}: {{ row.count }} papers; {{ row.cumulative }} cumulative"
          >
            <div class="publication-chart__track">
              <div class="publication-chart__bar{% if forloop.last %} publication-chart__bar--latest{% endif %}" style="height: {{ bar_height }}%">
                <span class="publication-chart__value">{{ row.count }}</span>
              </div>
            </div>
            <span class="publication-chart__year">{{ row.year }}</span>
          </li>
        {% endfor %}
      </ol>
      {% assign current_year = 'now' | date: '%Y' | plus: 0 %}
      <figcaption id="publication-chart-caption">
        Published and accepted papers by journal or conference year
        {%- if metrics.by_year.last.year > current_year %}, including assigned {{ metrics.by_year.last.year }} volumes{% endif -%}
        . Conference talks are excluded.
      </figcaption>
    </figure>
    <a class="home-inline-link" href="{{ '/publications/' | relative_url }}"
      >Full publication list <i class="fa-solid fa-arrow-right" aria-hidden="true"></i
    ></a>
  </section>
{% endif %}
