<div class="research-framework" aria-label="Four connected research directions">
  <ol class="research-framework__flow">
    {% for interest in page.research_interests %}
      <li>
        <a href="#{{ interest.id }}" class="framework-stage framework-stage--{{ interest.key }}">
          <span class="framework-step"
            >0{{ forloop.index }}
            <span>{{ interest.step }}</span></span
          >
          <span class="framework-symbol" aria-hidden="true">{% include research-icon.liquid icon=interest.key %}</span>
          <strong>{{ interest.diagram_label }}</strong>
        </a>
        {% unless forloop.last %}<i class="fa-solid fa-chevron-right framework-connector" aria-hidden="true"></i>{% endunless %}
      </li>
    {% endfor %}
  </ol>
</div>
